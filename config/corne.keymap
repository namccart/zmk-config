#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYMB 1
#define NAV 2
#define FUNC 3
#define MOUSE 4
#define BT 5

/ {
    behaviors {
        lt_quick_tap: layer_tap_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
};

/ {
    macros {
        winright: winright {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        winup: winup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp UP>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        windown: windown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp DOWN>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        winleft: winleft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        wkspcup: wkspcup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RALT>
                , <&macro_tap &kp UP>
                , <&macro_release &kp RCTRL &kp RALT>
                ;
        };
        wkspcdown: wkspcdown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RALT>
                , <&macro_tap &kp DOWN>
                , <&macro_release &kp RCTRL &kp RALT>
                ;
        };
        lock: lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp L>
                , <&macro_release &kp LGUI>
                ;
        };
    };
};

/ {
        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        display-name = "base";
                        bindings = <
   &trans &lt_quick_tap MOUSE Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I  &kp O  &kp P &trans
   &trans &kp A &hm LALT S &hm LCTRL D &kp F &kp G   &kp H &kp J  &hm RCTRL K  &hm RALT L   &kp SEMI &trans
   &trans &mt LSHFT Z &lt_quick_tap BT X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &mt RSHFT FSLH &trans
                  &lt SYMB DEL &kp TAB &lt_quick_tap NAV BKSP   &lt_quick_tap NAV SPACE &kp RET &lt SYMB ESC
                        >;
                };
                symb_layer {
                        display-name = "sym";
                        bindings = <
   &trans &kp EXCL  &kp AT  &kp LBRC  &kp RBRC  &kp AMPS   &kp FSLH  &kp N7  &kp N8  &kp N9 &kp MINUS &trans
   &trans &kp HASH &kp DLLR &kp LPAR &kp RPAR &kp ASTRK   &kp ASTRK  &kp N4  &kp N5  &kp N6 &kp PLUS &trans
   &trans &kp PRCNT  &kp CARET &kp LBKT &kp RBKT &kp UNDER   &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp DOT &trans
                  &to 0  &trans  &trans   &kp RET &kp N0  &tog FUNC
                        >;
                };

                nav_layer {
                        display-name = "nav";
                        bindings = <
   &trans &caps_word  &wkspcup  &winup  &wkspcdown  &trans   &kp PG_UP  &kp HOME  &kp UP  &kp END &kp INS &trans
   &trans &tog SYMB &winleft &windown &winright &trans   &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT &lock &trans

   &trans &tog NAV &trans &trans &trans &trans   &kp MINUS  &kp DQT  &kp SQT  &kp BSLH  &kp GRAVE &trans
                  &to 0 &trans &trans   &trans  &kp LGUI &tog SYMB
                        >;
                };
                func_layer {
                        display-name = "func";
                        bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &kp F7 &kp F8 &kp F9 &kp F11 &trans
   &trans &trans &kp LALT &kp LCTRL &trans &trans   &trans &kp F4 &kp F5 &kp F6 &kp F12 &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp F1 &kp F2 &kp F3 &trans &trans
                  &to 0 &trans &trans   &trans &kp F10 &tog FUNC
                        >;
                };
                mouse_layer {
                        display-name = "mouse";
                        bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &msc SCRL_UP &mmv MOVE_UP &msc SCRL_LEFT &trans &trans
   &trans &trans &trans &trans &trans &trans   &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_RIGHT &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                  &to 0 &trans &trans   &mkp LCLK &mkp RCLK &mkp MCLK
                        >;
                };
                bt_layer {
                        display-name = "bt";
                        bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &bt BT_PRV &bt BT_NXT &trans &bt BT_CLR &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                  &to 0 &trans &trans   &trans &trans &trans
                        >;
                };
        };
};
