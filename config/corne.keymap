#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYMB 1
#define NAV 2


/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
};

/ {
    macros {
        winright: winright {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        winup: winup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp UP>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        windown: windown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp DOWN>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        winleft: winleft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RGUI>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp RCTRL &kp RGUI>
                ;
        };
        wkspcup: wkspcup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RALT>
                , <&macro_tap &kp UP>
                , <&macro_release &kp RCTRL &kp RALT>
                ;
        };
        wkspcdown: wkspcdown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RALT>
                , <&macro_tap &kp DOWN>
                , <&macro_release &kp RCTRL &kp RALT>
                ;
        };
        lock: lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp L>
                , <&macro_release &kp LGUI>
                ;
        };
    };
};

/ {
        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        bindings = <
   &trans &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I  &kp O  &kp P &trans
   &trans &kp A &hm LALT S &hm LCTRL D &kp F &kp G   &kp H &kp J  &hm RCTRL K  &hm RALT L   &kp SEMI &trans
   &trans &mt LSHFT Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &mt RSHFT FSLH &trans
                  &lt SYMB TAB &kp BSPC &lt NAV DEL   &lt NAV ESC &kp SPACE &lt SYMB RET
                        >;
                };
                symb_layer {
                        bindings = <
   &trans &kp EXCL  &kp AT  &kp LBRC  &kp RBRC  &kp AMPS   &kp FSLH  &kp N7  &kp N8  &kp N9 &kp MINUS &trans
   &trans &kp HASH &kp DLLR &kp LPAR &kp RPAR &kp ASTRK   &kp ASTRK  &kp N4  &kp N5  &kp N6 &kp PLUS &trans
   &trans &kp PRCNT  &kp CARET &kp LBRC &kp RBRC &kp UNDER   &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp DOT &trans
                  &trans  &trans  &kp CAPS   &tog SYMB  &kp RET  &kp N0
                        >;
                };

                nav_layer {
                        bindings = <
   &trans &kp F1  &wkspcup  &winup  &wkspcdown  &kp F7   &kp PG_UP  &kp HOME  &kp UP  &kp END &kp INS &trans
   &trans &kp F2 &winleft &windown &winright &kp F8   &kp PG_DN  &kp LEFT  &hm RCTRL DOWN  &hm RALT RIGHT &lock &trans
   &trans &kp F3  &kp F4 &kp F5 &kp F6 &kp F9   &kp MINUS  &kp DQT  &kp SQT  &kp BSLH  &kp GRAVE &trans
                  &kp F10  &kp F11  &kp F12   &tog NAV  &trans  &kp LGUI
                        >;
                };
        };
};
